# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML
*.unity    text eol=lf
*.prefab   text eol=lf
*.mat      text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf
*.cs       text eol=lf diff=csharp

# Binary
*.png  binary
*.jpg  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
